# ─────────────────────────────────────────────────────────────────────────────
# Electro Thina — Variables de entorno de ejemplo
# Copiar a .env.local y completar con los valores reales.
# NUNCA commitear .env.local — ya está en .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Autenticación (sesión admin) ──────────────────────────────────────────────
# Clave secreta para firmar las cookies JWT (mín. 32 caracteres).
# Generá una con: openssl rand -base64 32
# IMPORTANTE: lib/auth/session.ts y lib/middleware/auth.ts usan esta misma clave.
AUTH_SECRET=reemplazar_con_clave_secreta_de_al_menos_32_caracteres

# ── Base de datos ─────────────────────────────────────────────────────────────
# PostgreSQL — requerido para el panel admin y el catálogo.
# El usuario admin se crea con: npx prisma db seed
DATABASE_URL=postgresql://usuario:password@host:5432/electrothina

# ── AWS S3 — Almacenamiento de archivos ───────────────────────────────────────
# Región donde está el bucket (ej: us-east-1, sa-east-1 para São Paulo)
AWS_REGION=us-east-1

# Credenciales IAM con permisos s3:PutObject y s3:PutObjectAcl sobre el bucket
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Nombre del bucket S3
AWS_S3_BUCKET=electro-thina-media

# URL base pública del bucket (sin trailing slash).
# Formato: https://{bucket}.s3.{region}.amazonaws.com
AWS_S3_PUBLIC_URL=https://electro-thina-media.s3.us-east-1.amazonaws.com

# ── CDN (opcional) ────────────────────────────────────────────────────────────
# Si usás CloudFront u otro CDN frente al bucket, definí CDN_URL.
# Cuando está definida, las URLs de archivos usarán este dominio en lugar
# del endpoint directo de S3 (mejor rendimiento y caché de edge).
# CDN_URL=https://cdn.electrothina.com

# ── Carpetas en S3 ────────────────────────────────────────────────────────────
# Los archivos se organizan automáticamente por tipo:
#   marcas/logos/          → logos de marcas (PNG/WebP)
#   productos/imagenes/    → imagen principal de producto
#   productos/galeria/     → imágenes de galería de producto
#   productos/fichas/      → PDFs de fichas técnicas
#
# Ejemplo de URL generada:
#   https://electro-thina-media.s3.us-east-1.amazonaws.com/productos/imagenes/1709123456789-aislador-polimerico-22kv.jpg
# Con CDN:
#   https://cdn.electrothina.com/marcas/logos/1709123456789-abb.png
