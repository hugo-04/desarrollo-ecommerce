// ============================================================
// Prisma Schema — Electro Thina
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────
// Administrador (login del panel)
// ──────────────────────────────────────────────────────────
model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

// ──────────────────────────────────────────────────────────
// Categorías
// ──────────────────────────────────────────────────────────
model Category {
  id            Int       @id @default(autoincrement())
  name          String    @unique           // @unique ya crea B-tree index
  slug          String    @unique           // @unique ya crea B-tree index
  image         String    @default("")
  imageAlt      String?
  color         String    @default("#1C2870")
  subcategories String[]
  count         Int       @default(0)
  featured      Boolean   @default(false)

  products      Product[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // count desc → home page muestra las categorías con más productos primero
  @@index([count(sort: Desc)])

  @@map("categories")
}

// ──────────────────────────────────────────────────────────
// Marcas
// ──────────────────────────────────────────────────────────
model Brand {
  id             Int       @id @default(autoincrement())
  name           String    @unique          // @unique ya crea B-tree index
  logo           String    @default("")
  logoAlt        String?
  showInCarousel Boolean   @default(false)

  products       Product[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Filtra marcas del carrusel sin full scan
  @@index([showInCarousel])

  @@map("brands")
}

// ──────────────────────────────────────────────────────────
// Libro de Reclamaciones (INDECOPI — Ley N° 29571)
// ──────────────────────────────────────────────────────────
model Reclamacion {
  id          Int      @id @default(autoincrement())

  // Datos del consumidor
  nombres     String
  apellidos   String
  tipoDoc     String   // DNI | RUC | CE | Pasaporte
  nroDoc      String
  domicilio   String   @default("")
  email       String
  telefono    String   @default("")

  // Tipo de reclamo (INDECOPI distingue queja y reclamación)
  tipo        String   // RECLAMACION | QUEJA
  tipoBien    String   // PRODUCTO | SERVICIO
  descripcion String
  pedido      String

  // Gestión interna
  estado      String   @default("PENDIENTE") // PENDIENTE | EN_PROCESO | RESPONDIDO | CERRADO
  respuesta   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([estado])
  @@index([createdAt(sort: Desc)])

  @@map("reclamaciones")
}

// ──────────────────────────────────────────────────────────
// Productos
// ──────────────────────────────────────────────────────────
model Product {
  id              Int      @id @default(autoincrement())
  sku             String   @unique          // @unique ya crea B-tree index
  name            String
  description     String   @default("")
  fullDescription String   @default("")

  image           String   @default("")
  imageAlt        String?
  gallery         String[]
  galleryAlts     String[]

  specs           String[]
  fichaTecnica    String?

  featured        Boolean  @default(false)
  bestSeller      Boolean  @default(false)
  rating          Float    @default(4.5)

  category        Category @relation(fields: [categoryId], references: [id])
  categoryId      Int

  brand           Brand    @relation(fields: [brandId], references: [id])
  brandId         Int

  technicalSpecs  Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ── Índices de relación (JOIN rápido) ─────────────────
  @@index([categoryId])
  @@index([brandId])

  // ── Índices de filtros booleanos ──────────────────────
  @@index([featured])
  @@index([bestSeller])
  // Composite para la query del home (featured + bestSeller a la vez)
  @@index([featured, bestSeller])

  // ── Sort por rating ───────────────────────────────────
  @@index([rating(sort: Desc)])

  @@map("products")
}
