// ============================================================
// Prisma Schema — Electro Thina
// ============================================================
// Para activar:
//   1. npm install prisma @prisma/client
//   2. Crear .env con DATABASE_URL="postgresql://user:pass@host:5432/electrothina"
//   3. npx prisma migrate dev --name init
//   4. Descomentar el cliente en lib/db/index.ts
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────
// Administrador (login del panel)
// ──────────────────────────────────────────────────────────
model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

// ──────────────────────────────────────────────────────────
// Categorías
// ──────────────────────────────────────────────────────────
model Category {
  id              Int       @id @default(autoincrement())
  name            String    @unique
  slug            String    @unique
  image           String    @default("")
  color           String    @default("#1C2870")
  subcategories   String[]  // array de strings (PostgreSQL)
  count           Int       @default(0)

  products        Product[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("categories")
}

// ──────────────────────────────────────────────────────────
// Marcas
// ──────────────────────────────────────────────────────────
model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  logo      String    @default("")

  products  Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("brands")
}

// ──────────────────────────────────────────────────────────
// Especificación técnica (tabla de parámetros del producto)
// ──────────────────────────────────────────────────────────
model TechnicalSpec {
  id        Int     @id @default(autoincrement())
  label     String
  value     String
  order     Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  @@map("technical_specs")
}

// ──────────────────────────────────────────────────────────
// Productos
// ──────────────────────────────────────────────────────────
model Product {
  id              Int     @id @default(autoincrement())
  sku             String  @unique
  name            String
  description     String  @default("")
  fullDescription String  @default("")

  // Imagen principal y galería
  image           String  @default("")
  gallery         String[] // URLs adicionales

  // Especificaciones rápidas (badges/etiquetas)
  specs           String[]

  // PDF ficha técnica (opcional)
  fichaTecnica    String?

  // Flags
  featured        Boolean @default(false)
  bestSeller      Boolean @default(false)
  rating          Float   @default(4.5)

  // Relaciones
  category        Category @relation(fields: [categoryId], references: [id])
  categoryId      Int

  brand           Brand    @relation(fields: [brandId], references: [id])
  brandId         Int

  technicalSpecs  TechnicalSpec[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("products")
}
