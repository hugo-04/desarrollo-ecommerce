// ============================================================
// Prisma Schema — Electro Thina
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────
// Administrador (login del panel)
// ──────────────────────────────────────────────────────────
model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

// ──────────────────────────────────────────────────────────
// Categorías
// ──────────────────────────────────────────────────────────
model Category {
  id            Int       @id @default(autoincrement())
  name          String    @unique           // @unique ya crea B-tree index
  slug          String    @unique           // @unique ya crea B-tree index
  image         String    @default("")
  color         String    @default("#1C2870")
  subcategories String[]
  count         Int       @default(0)

  products      Product[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // count desc → home page muestra las categorías con más productos primero
  @@index([count(sort: Desc)])

  @@map("categories")
}

// ──────────────────────────────────────────────────────────
// Marcas
// ──────────────────────────────────────────────────────────
model Brand {
  id             Int       @id @default(autoincrement())
  name           String    @unique          // @unique ya crea B-tree index
  logo           String    @default("")
  logoAlt        String?
  showInCarousel Boolean   @default(false)

  products       Product[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Filtra marcas del carrusel sin full scan
  @@index([showInCarousel])

  @@map("brands")
}

// ──────────────────────────────────────────────────────────
// Productos
// ──────────────────────────────────────────────────────────
model Product {
  id              Int      @id @default(autoincrement())
  sku             String   @unique          // @unique ya crea B-tree index
  name            String
  description     String   @default("")
  fullDescription String   @default("")

  image           String   @default("")
  imageAlt        String?
  gallery         String[]
  galleryAlts     String[]

  specs           String[]
  fichaTecnica    String?

  featured        Boolean  @default(false)
  bestSeller      Boolean  @default(false)
  rating          Float    @default(4.5)

  category        Category @relation(fields: [categoryId], references: [id])
  categoryId      Int

  brand           Brand    @relation(fields: [brandId], references: [id])
  brandId         Int

  technicalSpecs  Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ── Índices de relación (JOIN rápido) ─────────────────
  @@index([categoryId])
  @@index([brandId])

  // ── Índices de filtros booleanos ──────────────────────
  @@index([featured])
  @@index([bestSeller])
  // Composite para la query del home (featured + bestSeller a la vez)
  @@index([featured, bestSeller])

  // ── Sort por rating ───────────────────────────────────
  @@index([rating(sort: Desc)])

  @@map("products")
}
