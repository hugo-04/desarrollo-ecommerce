// ============================================================
// Prisma Schema — Electro Thina
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────────────────
// Analytics: visitas diarias agregadas por ruta
// ──────────────────────────────────────────────────────────
model DailyView {
  id    Int      @id @default(autoincrement())
  path  String
  date  DateTime @db.Date
  count Int      @default(1)

  @@unique([path, date])
  @@index([date(sort: Desc)])
  @@map("daily_views")
}

// ──────────────────────────────────────────────────────────
// Administrador (login del panel)
// ──────────────────────────────────────────────────────────
model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

// ──────────────────────────────────────────────────────────
// Subcategorías (entidad propia — many-to-many con Category)
// ──────────────────────────────────────────────────────────
model Subcategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String?  @unique
  image       String   @default("")
  imageAlt    String?
  imageTitle  String?
  description String   @default("")
  keywords    String[]

  categories Category[]
  products   Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("subcategories")
}

// ──────────────────────────────────────────────────────────
// Categorías
// ──────────────────────────────────────────────────────────
model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique // @unique ya crea B-tree index
  slug        String  @unique // @unique ya crea B-tree index
  image       String  @default("")
  imageAlt    String?
  imageTitle  String?
  description String  @default("")
  keywords    String[]
  count       Int     @default(0)
  featured    Boolean @default(false)

  subs     Subcategory[]
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // count desc → home page muestra las categorías con más productos primero
  @@index([count(sort: Desc)])
  @@map("categories")
}

// ──────────────────────────────────────────────────────────
// Marcas
// ──────────────────────────────────────────────────────────
model Brand {
  id             Int     @id @default(autoincrement())
  name           String  @unique // @unique ya crea B-tree index
  logo           String  @default("")
  logoAlt        String?
  showInCarousel Boolean @default(false)
  description    String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Filtra marcas del carrusel sin full scan
  @@index([showInCarousel])
  @@map("brands")
}

// ──────────────────────────────────────────────────────────
// Libro de Reclamaciones (INDECOPI — Ley N° 29571)
// ──────────────────────────────────────────────────────────
model Reclamacion {
  id Int @id @default(autoincrement())

  // Datos del consumidor
  nombres   String
  apellidos String
  tipoDoc   String // DNI | RUC | CE | Pasaporte
  nroDoc    String
  domicilio String @default("")
  email     String
  telefono  String @default("")

  // Tipo de reclamo (INDECOPI distingue queja y reclamación)
  tipo        String // RECLAMACION | QUEJA
  tipoBien    String // PRODUCTO | SERVICIO
  descripcion String
  pedido      String

  // Gestión interna
  estado    String  @default("PENDIENTE") // PENDIENTE | EN_PROCESO | RESPONDIDO | CERRADO
  respuesta String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([createdAt(sort: Desc)])
  @@map("reclamaciones")
}

// ──────────────────────────────────────────────────────────
// Hero Slider (portada principal del sitio)
// ──────────────────────────────────────────────────────────
model HeroSlide {
  id       Int     @id @default(autoincrement())
  label    String
  image    String  @default("")
  imageAlt String?
  gradient String  @default("from-[#003D73] via-[#00316b] to-[#00244f]")
  order    Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
  @@map("hero_slides")
}

// ──────────────────────────────────────────────────────────
// Blog
// ──────────────────────────────────────────────────────────
model BlogPost {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  excerpt     String   @default("")
  content     String   @default("")
  coverImage  String   @default("")
  coverAlt    String?
  image2      String   @default("")
  image2Alt   String?
  image3      String   @default("")
  image3Alt   String?
  tag         String?
  tagCategory String?
  metaTitle   String?
  metaDesc    String?
  keywords    String[]
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([published, createdAt(sort: Desc)])
  @@map("blog_posts")
}

// ──────────────────────────────────────────────────────────
// Nosotros — contenido editable (singleton, id=1)
// ──────────────────────────────────────────────────────────
model NosotrosConfig {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt

  @@map("nosotros_config")
}

// ──────────────────────────────────────────────────────────
// Especialidades (sección "Nuestras especialidades" del home)
// ──────────────────────────────────────────────────────────
model Especialidad {
  id          Int     @id @default(autoincrement())
  title       String
  subtitle    String  @default("")
  description String  @default("")
  image       String  @default("")
  imageAlt    String?
  gradient    String  @default("from-[#1B2B4B] to-[#003D73]")
  order       Int     @default(0)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
  @@map("especialidades")
}

// ──────────────────────────────────────────────────────────
// Entidades Bancarias (sección "Medios de Pago" del footer)
// ──────────────────────────────────────────────────────────
model EntidadBancaria {
  id         Int     @id @default(autoincrement())
  name       String  @unique
  logo       String  @default("")
  logoAlt    String?
  nroCuenta  String?
  nroCci     String?
  order      Int     @default(0)
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
  @@map("entidades_bancarias")
}

// ──────────────────────────────────────────────────────────
// Productos
// ──────────────────────────────────────────────────────────
model Product {
  id              Int    @id @default(autoincrement())
  name            String @unique
  description     String @default("")
  fullDescription String @default("")

  image       String   @default("")
  imageAlt    String?
  imageTitle  String?
  gallery     String[]
  galleryAlts String[]

  modelo       String?
  medidas      String[]
  keywords     String[]
  fichaTecnica String?

  featured   Boolean @default(false)
  bestSeller Boolean @default(false)
  rating     Float   @default(4.5)

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId Int

  brands Brand[]

  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  subcategoryId Int?

  technicalSpecs Json?
  search_vector  Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Índices de relación (JOIN rápido) ─────────────────
  @@index([categoryId])

  @@index([subcategoryId])
  // ── Índices de filtros booleanos ──────────────────────
  @@index([featured])
  @@index([bestSeller])
  // Composite para la query del home (featured + bestSeller a la vez)
  @@index([featured, bestSeller])
  // ── Sort por rating ───────────────────────────────────
  @@index([rating(sort: Desc)])
  @@map("products")
}
